# Copy to .env.local and fill in. Never commit .env.local.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

ADMIN_EMAILS=

# Live domain, used for social share previews (e.g. https://thenutripath.in)
NEXT_PUBLIC_SITE_URL=

# Cloudinary (admin plan image uploads): Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google sign-in popup (shows your domain instead of supabase.co). Same OAuth client as in Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
